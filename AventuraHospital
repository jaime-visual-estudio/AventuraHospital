    public static void mostrarEstado() {
        String objetos = "";
        for (int k = 1; k <= 3; k++) {
            if (mochila[k]) {
                objetos = objetos + nombreObjeto[k] + ", ";
            }
        }
        if (objetos.length() == 0) {
            objetos = "vacía";
        } else {

            objetos = objetos.substring(0, objetos.length() - 2);
        }
        System.out.println("\n--- Vidas: " + vidas + " | Mochila: " + objetos + " ---");
    }

    public static int pedir(Scanner sc, String titulo, String preg, String op1, String op2, String op3) {
        int eleccion = 0;

        while (eleccion == 0) {
            mostrarEstado();
            System.out.println("\n=== " + titulo + " ===");
            System.out.println(preg);
            System.out.println("1. " + op1);
            System.out.println("2. " + op2);
            System.out.println("3. " + op3);

            boolean puedeCurar = mochila[BOTIQUIN] && vidas < 3;
            if (puedeCurar) {
                System.out.println("4. Usar el botiquín (recuperas 1 vida)");
            }

            System.out.print("Elige una opción: ");
            String linea = sc.nextLine().trim();

            if (linea.equals("1")) {
                eleccion = 1;
            } else if (linea.equals("2")) {
                eleccion = 2;
            } else if (linea.equals("3")) {
                eleccion = 3;
            } else if (linea.equals("4") && puedeCurar) {
                mochila[BOTIQUIN] = false;
                vidas = vidas + 1;
                System.out.println("\nUsas el botiquín y recuperas una vida.");
            } else {
                System.out.println("\nOpción no válida. Escribe 1, 2 o 3.");
            }
        }
        return eleccion;
    }

