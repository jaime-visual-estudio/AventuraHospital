    public static int pedirNumero(Scanner sc, String texto, int max) {
        int numero = 0;

        while (numero == 0) {
            System.out.print(texto);
            String linea = sc.nextLine().trim();

            for (int k = 1; k <= max; k++) {
                if (linea.equals("" + k)) {
                    numero = k;
                }
            }

            if (numero == 0) {
                System.out.println("Número no válido. Escribe un número del 1 al " + max + ".");
            }
        }
        return numero;
    }

