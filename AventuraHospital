    public static boolean paresONones(Scanner sc) {
        mostrarEnemigo("ENEMIGO: EL ENFERMERO SINIESTRO");
        System.out.println("Un enfermero te bloquea el paso con una sonrisa extraña.");
        System.out.println("'Juguemos a pares o nones. Gana quien consiga 2 puntos. Si pierdes, no sales de aquí.'");

        int eleccion = pedirNumero(sc, "\n¿Qué eliges? 1 = Pares, 2 = Nones: ", 2);
        boolean pares = (eleccion == 1);
        int ganadas = 0;
        int perdidas = 0;

        while (ganadas < 2 && perdidas < 2) {
            int tuNumero = pedirNumero(sc, "\nSaca los dedos de una mano (1 a 5): ", 5);
            int suNumero = (int) (Math.random() * 5) + 1;
            int suma = tuNumero + suNumero;
            System.out.println("Tú sacas " + tuNumero + " y el enfermero saca " + suNumero + ". Suman " + suma + ".");

            boolean salePar = (suma % 2 == 0);
            if (salePar == pares) {
                ganadas = ganadas + 1;
                System.out.println("Punto para ti. (" + ganadas + " - " + perdidas + ")");
            } else {
                perdidas = perdidas + 1;
                System.out.println("Punto para el enfermero. (" + ganadas + " - " + perdidas + ")");
            }
        }

        if (ganadas == 2) {
            System.out.println("\nEl enfermero gruñe y se aparta. Has ganado y puedes seguir.");
            return true;
        }
        System.out.println("\nEl enfermero sonríe. Has perdido el juego y no sales de aquí.");
        return false;
    }

    public static boolean ruletaRusa(Scanner sc) {
        mostrarEnemigo("ENEMIGO: EL FARMACÉUTICO");
        System.out.println("El farmacéutico te espera con un revólver de seis cámaras y una sola bala.");
        System.out.println("'Jugaremos a la ruleta rusa. Disparamos por turnos hasta que suene la bala.'");

        int quien = pedirNumero(sc, "\n¿Quién dispara primero? 1 = Tú, 2 = El farmacéutico: ", 2);
        boolean turnoTuyo = (quien == 1);
        int bala = (int) (Math.random() * 6) + 1;

        for (int disparo = 1; disparo <= 6; disparo++) {
            if (turnoTuyo) {
                System.out.print("\nTu turno. Pulsa Enter para apretar el gatillo...");
            } else {
                System.out.print("\nTurno del farmacéutico. Pulsa Enter para continuar...");
            }
            sc.nextLine();

            if (disparo == bala) {
                System.out.println("¡BANG!");
                if (turnoTuyo) {
                    System.out.println("La bala era para ti. Has perdido.");
                    return false;
                }
                System.out.println("La bala era para el farmacéutico. Has ganado.");
                return true;
            }

            System.out.println("Clic... la cámara estaba vacía.");
            turnoTuyo = !turnoTuyo;
        }
        return true;
    }

    public static void dibujarAhorcado(int fallos) {
        System.out.println(" +---+");
        System.out.println(" |   |");

        if (fallos >= 1) {
            System.out.println(" |   O");
        } else {
            System.out.println(" |");
        }

        if (fallos >= 4) {
            System.out.println(" |  -|-");
        } else if (fallos == 3) {
            System.out.println(" |  -|");
        } else if (fallos == 2) {
            System.out.println(" |   |");
        } else {
            System.out.println(" |");
        }

        if (fallos >= 6) {
            System.out.println(" |  | |");
        } else if (fallos == 5) {
            System.out.println(" |  |");
        } else {
            System.out.println(" |");
        }

        System.out.println("=====");
    }

    public static boolean ahorcado(Scanner sc) {
        mostrarEnemigo("JEFE FINAL: EL DOCTOR");
        System.out.println("En el hall te espera el Doctor, el dueño del hospital. Bloquea la salida.");
        System.out.println("'Adivina mi palabra secreta antes de cometer 6 errores y te dejaré marchar.'");

        String[] palabras = { "ANESTESIA", "QUIROFANO", "AMBULANCIA", "ENFERMERO", "PACIENTE" };
        String secreta = palabras[(int) (Math.random() * palabras.length)];

        String progreso = "";
        for (int k = 0; k < secreta.length(); k++) {
            progreso = progreso + "_";
        }

        String usadas = "";
        int fallos = 0;

        while (fallos < 6 && progreso.indexOf("_") != -1) {
            String visible = "";
            for (int k = 0; k < progreso.length(); k++) {
                visible = visible + progreso.charAt(k) + " ";
            }

            System.out.println();
            dibujarAhorcado(fallos);
            System.out.println("Palabra: " + visible);
            System.out.println("Errores: " + fallos + " de 6 | Letras usadas: " + usadas);
            System.out.print("Escribe una letra: ");
            String letra = sc.nextLine().trim().toUpperCase();

            if (letra.length() != 1 || letra.charAt(0) < 'A' || letra.charAt(0) > 'Z') {
                System.out.println("Escribe solo una letra, de la A a la Z.");
            } else if (usadas.indexOf(letra) != -1) {
                System.out.println("Esa letra ya la has dicho.");
            } else {
                usadas = usadas + letra;

                if (secreta.indexOf(letra) != -1) {
                    System.out.println("¡Acierto!");
                    String nuevo = "";
                    for (int k = 0; k < secreta.length(); k++) {
                        if (secreta.charAt(k) == letra.charAt(0)) {
                            nuevo = nuevo + letra;
                        } else {
                            nuevo = nuevo + progreso.charAt(k);
                        }
                    }
                    progreso = nuevo;
                } else {
                    fallos = fallos + 1;
                    System.out.println("Esa letra no está.");
                }
            }
        }

        if (progreso.indexOf("_") == -1) {
            System.out.println("\nLa palabra era " + secreta + ". El Doctor se aparta furioso: puedes marcharte.");
            return true;
        }

        System.out.println();
        dibujarAhorcado(fallos);
        System.out.println("\nLa palabra era " + secreta + ". El Doctor ha ganado y no te deja salir.");
        return false;
    }

    public static void jugar(Scanner sc) {

        vidas = 3;
        for (int k = 1; k <= 3; k++) {
            mochila[k] = false;
        }

        boolean vivo = true;
        int numero = 1;

        while (vivo && numero <= 11) {
            switch (numero) {
                case 1:  vivo = escena1(sc);  break;
                case 2:  vivo = escena2(sc);  break;
                case 3:
                    vivo = escena3(sc);
                    if (vivo) {
                        vivo = paresONones(sc);
                    }
                    break;
                case 4:  vivo = escena4(sc);  break;
                case 5:  vivo = escena5(sc);  break;
                case 6:  vivo = escena6(sc);  break;
                case 7:  vivo = escena7(sc);  break;
                case 8:
                    vivo = escena8(sc);
                    if (vivo) {
                        vivo = ruletaRusa(sc);
                    }
                    break;
                case 9:  vivo = escena9(sc);  break;
                case 10: vivo = escena10(sc); break;
                case 11: vivo = escena11(sc); break;
            }
            numero = numero + 1;
        }

        if (vivo) {
            vivo = ahorcado(sc);
        }

        if (vivo) {
            escena12(sc);
        } else {
            System.out.println("\nHas muerto. FIN DE LA PARTIDA.");
        }
    }

